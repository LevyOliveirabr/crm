# crm-fled — variáveis de ambiente (copie para .env.local e preencha).
# Fonte: SPEC.md seção 2.

# Supabase (cliente / browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (somente servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Somente servidor (MCP — entrega 2)
SUPABASE_JWT_SECRET=

# URL pública da aplicação
APP_URL=http://localhost:3000

# Lembrete diário por e-mail (cron da Vercel às 07:00 BRT, dias úteis)
# Sem RESEND_API_KEY o cron roda mas não envia nada.
RESEND_API_KEY=
EMAIL_FROM=CRM F-Led <onboarding@resend.dev>
# Segredo que a Vercel envia no header Authorization do cron. Obrigatório.
CRON_SECRET=

# Link público de aceite de orçamento (opcional; usa SUPABASE_JWT_SECRET se vazio)
ACEITE_SECRET=

# Monitoramento de erros (opcional). Sem DSN o Sentry fica desligado.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
